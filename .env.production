# 生产环境（npm run build / build:prod 时加载）
NODE_ENV = production

# 当前环境标识
VITE_APP_ENV = production

# 接口基础路径：由 nginx 反向代理到生产后端
VITE_API_BASE_URL = /api

# 打包输出目录
VITE_OUTPUT_DIR = dist

# 生产环境关闭 sourcemap，减小体积、避免源码泄露
VITE_SOURCEMAP = false

# 移除 console / debugger
VITE_DROP_CONSOLE = true

# 是否开启 gzip 压缩产物
VITE_BUILD_GZIP = true
