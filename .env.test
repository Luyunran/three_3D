# 测试环境（npm run build:test 时加载）
NODE_ENV = production

# 当前环境标识
VITE_APP_ENV = test

# 接口基础路径：由 nginx 反向代理到测试后端
VITE_API_BASE_URL = /api

# 打包输出目录
VITE_OUTPUT_DIR = dist-test

# 是否开启 sourcemap（测试环境保留便于排查）
VITE_SOURCEMAP = true

# 是否移除 console / debugger
VITE_DROP_CONSOLE = false

# 是否开启 gzip 压缩产物
VITE_BUILD_GZIP = true
